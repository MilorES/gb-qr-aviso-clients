<Window x:Class="GbQrAvisosCliente.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GB Avisos"
        WindowState="Maximized"
        Topmost="False"
        ResizeMode="CanMinimize"
        MinWidth="900"
        MinHeight="600"
        Background="#F4F7F5"
        Foreground="#16372E"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewTouchDown="Window_PreviewTouchDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandGreen" Color="#176348" />
        <SolidColorBrush x:Key="MutedText" Color="#698078" />
        <Style x:Key="AlertRowStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE7E1" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="24,22" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GB AVISOS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" />
                <TextBlock Text="Avisos del local" FontSize="36" FontWeight="SemiBold" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="22" Padding="18,10" Background="#E8F2ED" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{Binding StatusBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Button Grid.Column="2" Click="OpenSettings_Click" Margin="12,0,0,0" Padding="10"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    VerticalAlignment="Center" ToolTip="Configuración">
                <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource MutedText}"
                      Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94s-0.02-0.64-0.07-0.94l2.03-1.58a0.5,0.5,0,0,0,0.12-0.64l-1.92-3.32a0.5,0.5,0,0,0-0.61-0.22l-2.39,0.96a7.28,7.28,0,0,0-1.63-0.94l-0.36-2.54A0.49,0.49,0,0,0,13.88,2h-3.76a0.49,0.49,0,0,0-0.49,0.41L9.27,4.95a7.28,7.28,0,0,0-1.63,0.94l-2.39-0.96a0.5,0.5,0,0,0-0.61,0.22L2.72,8.47a0.5,0.5,0,0,0,0.12,0.64l2.03,1.58c-0.05,0.31-0.07,0.63-0.07,0.94s0.02,0.63,0.07,0.94l-2.03,1.58a0.5,0.5,0,0,0-0.12,0.64l1.92,3.32a0.5,0.5,0,0,0,0.61,0.22l2.39-0.96c0.49,0.38,1.03,0.7,1.63,0.94l0.36,2.54c0.04,0.24,0.25,0.41,0.49,0.41h3.76c0.24,0,0.45-0.17,0.49-0.41l0.36-2.54c0.59-0.24,1.14-0.56,1.63-0.94l2.39,0.96c0.23,0.08,0.49-0.01,0.61-0.22l1.92-3.32a0.5,0.5,0,0,0-0.12-0.64l-2.03-1.58zM12,15.5a3.5,3.5,0,1,1,0-7a3.5,3.5,0,0,1,0,7z" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="RECIBIDO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="AVISO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DCE7E1" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AlertRowStyle}" Background="{Binding RowBackground}" Padding="24,22"
                                    MouseLeftButtonUp="AlertRow_MouseLeftButtonUp"
                                    TouchDown="AlertRow_TouchDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ReceivedAt, StringFormat={}{0:HH:mm:ss dd:MM:yyyy}}"
                                               FontSize="20" Foreground="#526A61" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayText}" FontSize="30" FontWeight="{Binding MessageWeight}" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="4,14,4,0">
            <TextBlock Text="Los avisos más recientes aparecen arriba" FontSize="14" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding AlertCountText}" FontSize="14" Foreground="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
